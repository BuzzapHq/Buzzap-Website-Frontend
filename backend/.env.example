# ---- Server ----
PORT=5000
NODE_ENV=development

# Frontend origin allowed by CORS (must match where Next.js runs)
CLIENT_URL=http://localhost:3000

# ---- Database ----
# MongoDB Atlas connection string
MONGO_URI=

# ---- Auth (JWT in httpOnly cookie) ----
# Use a long random string (e.g. `openssl rand -hex 32`)
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ---- Email (SMTP via Nodemailer) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Buzzap <hello@buzzaphq.com>"
# Where new-lead notifications go (defaults to SMTP_USER if unset)
LEADS_NOTIFY_EMAIL=

# ---- File storage (Cloudinary) — used by a later milestone ----
CLOUDINARY_URL=

# ---- Admin seed (used by `npm run seed` to create the single admin) ----
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin
